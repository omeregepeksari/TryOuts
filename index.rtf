<script type="module">\
  import \{ initializeApp \} from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";\
  import \{\
    getFirestore, collection, addDoc, serverTimestamp,\
    query, orderBy, limit, getDocs\
  \} from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";\
\
  // ---- REPLACE THESE WITH YOUR OWN FIREBASE PROJECT VALUES ----\
  const firebaseConfig = \{\
    apiKey: "YOUR_API_KEY",\
    authDomain: "YOUR_PROJECT_ID.firebaseapp.com",\
    projectId: "YOUR_PROJECT_ID",\
    storageBucket: "YOUR_PROJECT_ID.appspot.com",\
    messagingSenderId: "YOUR_SENDER_ID",\
    appId: "YOUR_APP_ID"\
  \};\
  // ---------------------------------------------------------------\
\
  let db = null;\
  try \{\
    if (!firebaseConfig.apiKey.startsWith('YOUR_')) \{\
      const app = initializeApp(firebaseConfig);\
      db = getFirestore(app);\
    \}\
  \} catch (e) \{\
    console.warn('Firebase not configured yet:', e);\
  \}\
\
  window.submitScore = async function(name, totalMoves) \{\
    if (!db) throw new Error('Firebase not configured');\
    await addDoc(collection(db, 'scores'), \{\
      name: String(name).slice(0, 16),\
      totalMoves: Math.round(totalMoves),\
      createdAt: serverTimestamp()\
    \});\
  \};\
\
  window.loadLeaderboard = async function() \{\
    if (!db) throw new Error('Firebase not configured');\
    const q = query(collection(db, 'scores'), orderBy('totalMoves', 'asc'), limit(10));\
    const snap = await getDocs(q);\
    return snap.docs.map(d => d.data());\
  \};\
</script>\
